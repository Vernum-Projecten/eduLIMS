#
# Every environment variable eduLIMS and its compose stack read. Copy this file
# and fill it in:
#
#   cp .env.example .env
#
# for local development (`pnpm dev`, `pnpm db:migrate` and `pnpm db:seed` read
# it) and on the production host beside compose.yaml. It is never committed
# (.gitignore). The values below are the local
# development defaults that compose.dev.yaml uses; on the production host
# replace every one marked "required". Generate a secret with:
#
#   openssl rand -hex 32
#
# Use hex for database passwords: they go into a postgres:// URL unescaped.

# ── The application ─────────────────────────────────────────────────────────

# PostgreSQL connection URL for the eduLIMS database. In production compose.yaml
# builds it from the EDULIMS_DB_* values below, so you set it only for
# `pnpm dev` and `pnpm db:migrate` on the host. Production requires TLS with a
# verified certificate: append ?sslmode=verify-full, plus
# &sslrootcert=<CA file> for a private CA (docs/deployment.md, "Database TLS").
DATABASE_URL=postgres://edulims:edulims@127.0.0.1:5432/edulims

# Required. The key Better Auth signs and encrypts sessions with, at least 32
# characters. Changing it signs every user out.
BETTER_AUTH_SECRET=

# Required. The public base URL users reach eduLIMS on, with no trailing slash.
# Better Auth builds the OAuth redirect URIs from it, so it must match the
# redirect URIs registered in the identity provider. Production requires https.
BETTER_AUTH_URL=http://localhost:3000

# NODE_ENV does not belong in this file. `pnpm dev` runs in development and
# `pnpm build` in production on their own, and Vite would build a broken
# production bundle with NODE_ENV=development set here. `pnpm db:seed` and
# `pnpm db:reset` set development themselves; the image and compose.yaml set
# production for the container.

# ── Identity providers ───────────────────────────────────────────────────────
# Administrators manage the identity providers (OIDC and SAML 2.0) in
# Admin → System → Identity providers; the first one comes from the host CLI
# (`idp add`, docs/deployment.md, "First start"). Nothing about a provider is
# configured here except the key that seals its secrets.

# Required in production. The AES-256 key that encrypts identity-provider
# secrets (client secrets, SAML signing keys) in the database: 32 random bytes,
# base64. Generate it with:
#
#   openssl rand -base64 32
#
# Keep it apart from BETTER_AUTH_SECRET and back it up: without it the stored
# secrets cannot be read. To rotate, move the old key to
# EDULIMS_DATA_KEY_PREVIOUS, set a new one, run `idp rekey`, then remove the
# previous key (docs/deployment.md, "Data key").
EDULIMS_DATA_KEY=
# EDULIMS_DATA_KEY_PREVIOUS=

# Origins of identity providers on a private or loopback network, comma
# separated (an on-premises IdP, the development Keycloak). Any other issuer
# must be a public https address, so an administrator cannot point eduLIMS at
# the internal network. The value below is the development Keycloak of
# compose.dev.yaml, which `pnpm db:seed` registers.
EDULIMS_IDP_PRIVATE_ORIGINS=http://localhost:8180

# The openEHR REST base URL of FerroEHR. compose.yaml sets it to the service on
# the backend network; for `pnpm dev` with `--profile ferroehr` it is:
FERROEHR_BASE_URL=http://localhost:8080/ferroehr/rest/openehr/v1

# The base URL of FerroBRIDGE's HTTP API. compose.yaml sets it to the service
# on the backend network; compose.dev.yaml runs no FerroBRIDGE, so in
# development it points at one you run yourself.
FERROBRIDGE_BASE_URL=http://localhost:8081

# Development only. When "true", the sign-in page offers a local email and
# password login that skips the identity provider, with the users from
# `pnpm db:seed` (student@, teacher@ and admin@example.test). It is refused in
# production; compose.yaml does not pass it to the container.
EDULIMS_DEV_LOGIN=true

# Development only: the host ports compose.dev.yaml publishes PostgreSQL,
# Keycloak and FerroEHR on, when the defaults are taken.
# EDULIMS_DEV_DB_PORT=5432
# EDULIMS_DEV_KEYCLOAK_PORT=8180
# EDULIMS_DEV_FERROEHR_PORT=8080

# The port the server listens on inside its container or on the host. The
# image sets 3000.
# PORT=3000

# ── The compose stack (compose.yaml, production host only) ────────────────────

# Required. The eduLIMS release to run, without the leading "v" (for example
# 0.1.0). An update changes this line and runs `docker compose pull`.
EDULIMS_VERSION=

# Required. The PostgreSQL bootstrap superuser's password.
POSTGRES_PASSWORD=

# The eduLIMS database role and database. The password is required.
EDULIMS_DB_USER=edulims
EDULIMS_DB_PASSWORD=
EDULIMS_DB_NAME=edulims

# The FerroEHR database role and database. The password is required.
FERROEHR_DB_USER=ferroehr
FERROEHR_DB_PASSWORD=
FERROEHR_DB_NAME=ferroehr

# The host address and port eduLIMS is published on. Keep the loopback address
# and put the host's TLS reverse proxy in front.
EDULIMS_BIND_HOST=127.0.0.1
EDULIMS_PORT=3000

# The host address and port the HL7 v2 MLLP listener is published on: the
# host's address on the lab network the analysers send from.
FERROBRIDGE_MLLP_BIND_HOST=127.0.0.1
FERROBRIDGE_MLLP_PORT=2575

# Keycloak in production, only with COMPOSE_PROFILES=keycloak (an optional
# service; leave it off when the institution runs its own identity provider).
# Setting KEYCLOAK_DB_PASSWORD makes the PostgreSQL init script create the
# `keycloak` role and database, so set it before the first `docker compose up`.
# KEYCLOAK_HOSTNAME is the public https URL behind the host's reverse proxy.
# The admin pair creates the first administrator on the first start; remove it
# once that password is changed.
# COMPOSE_PROFILES=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_HOSTNAME=
KEYCLOAK_BIND_HOST=127.0.0.1
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# The host directory pg_dump writes backups to (docs/deployment.md).
EDULIMS_BACKUP_DIR=./backups

# Log filters for the two Ferro services (tracing filter syntax).
FERROEHR_LOG_FILTER=info
FERROBRIDGE_LOG_FILTER=info

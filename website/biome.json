{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": ["**", "!**/*.md", "!**/*.svg", "!dist", "!.astro"]
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}

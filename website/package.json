{
  "name": "@edulims/website",
  "version": "0.0.0",
  "private": true,
  "description": "The eduLIMS documentation site (Astro Starlight), served at https://edulims.eu",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-docs.ts",
    "dev": "node scripts/sync-docs.ts && astro dev",
    "build": "node scripts/sync-docs.ts && astro build",
    "preview": "astro preview",
    "check:a11y": "playwright test",
    "check:links": "bash scripts/check-links.sh"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/starlight": "0.42.10",
    "astro": "7.4.7",
    "astro-mermaid": "2.2.0",
    "mermaid": "12.3.0",
    "sharp": "0.35.5",
    "starlight-llms-txt": "0.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6"
  }
}

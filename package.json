{
  "name": "edulims",
  "version": "0.1.1",
  "private": true,
  "description": "An open-source laboratory information management system for practical laboratory education",
  "license": "Apache-2.0",
  "author": "Ruben Talstra",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "dev:db": "bash scripts/dev/compose.sh up -d --wait",
    "dev:db:ferro": "bash scripts/dev/compose.sh --profile ferro up -d --wait",
    "dev:db:stop": "bash scripts/dev/compose.sh --profile ferro down",
    "dev:db:logs": "bash scripts/dev/compose.sh logs -f",
    "dev:setup": "pnpm dev:db && pnpm db:migrate && pnpm db:seed",
    "env:sync": "bash scripts/dev/env-sync.sh",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "pnpm i18n && tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm i18n && vitest run",
    "test:watch": "pnpm i18n && vitest",
    "test:coverage": "pnpm i18n && vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:migrate": "node --env-file-if-exists=.env src/server/cli.ts migrate",
    "db:seed": "pnpm i18n && NODE_ENV=development node --env-file-if-exists=.env src/server/db/seed.ts",
    "db:reset": "NODE_ENV=development node --env-file-if-exists=.env src/server/db/reset.ts && pnpm db:migrate && pnpm db:seed",
    "db:prune": "node --env-file-if-exists=.env src/server/cli.ts prune",
    "db:generate-types": "kysely-codegen --dialect postgres --out-file src/server/db/schema.gen.ts",
    "idp:add": "node --env-file-if-exists=.env src/server/cli.ts idp add",
    "idp:list": "node --env-file-if-exists=.env src/server/cli.ts idp list",
    "idp:enable": "node --env-file-if-exists=.env src/server/cli.ts idp enable",
    "idp:disable": "node --env-file-if-exists=.env src/server/cli.ts idp disable",
    "idp:rekey": "node --env-file-if-exists=.env src/server/cli.ts idp rekey",
    "scim:token": "node --env-file-if-exists=.env src/server/cli.ts scim token",
    "admin:grant": "node --env-file-if-exists=.env src/server/cli.ts admin grant",
    "admin:revoke": "node --env-file-if-exists=.env src/server/cli.ts admin revoke",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "i18n": "paraglide-js compile --project ./project.inlang --silent",
    "docs:dev": "pnpm --filter @edulims/website dev",
    "docs:build": "pnpm --filter @edulims/website build"
  },
  "dependencies": {
    "@better-auth/core": "1.7.20",
    "@better-auth/kysely-adapter": "1.7.20",
    "@better-auth/scim": "1.7.20",
    "@better-auth/sso": "1.7.20",
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/charts": "1.5.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-hotkeys": "0.23.1",
    "@tanstack/react-pacer": "0.24.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "better-auth": "1.7.20",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "date-fns": "4.4.0",
    "kysely": "0.29.8",
    "lucide-react": "1.71.0",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.21.0",
    "samlify": "2.15.1",
    "sonner": "2.0.8",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@inlang/paraglide-js": "3.2.1",
    "@inlang/plugin-message-format": "4.6.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-form-devtools": "0.2.34",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router-devtools": "1.167.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.0",
    "kysely-codegen": "0.20.0",
    "nitro": "3.0.261103-rc",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}

      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "conflict",
          "temporary": false
        }
      ],
      "groups": ["/Students", "/Teachers"]
    },
    {
      "username": "norole",
      "email": "norole@edulims.test",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "No Role",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "norole",
          "temporary": false
        }
      ]
    }
  ]
}

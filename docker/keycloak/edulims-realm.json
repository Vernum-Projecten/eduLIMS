{
  "realm": "edulims",
  "displayName": "eduLIMS (development)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "edulims-student",
        "description": "Student: registers samples, uploads results, reads only their own data"
      },
      {
        "name": "edulims-teacher",
        "description": "Teacher: manages and assesses the practicals they own"
      },
      {
        "name": "edulims-admin",
        "description": "Administrator: assigns roles and watches the integrations"
      }
    ]
  },
  "groups": [
    { "name": "Students", "path": "/Students", "realmRoles": ["edulims-student"] },
    { "name": "Teachers", "path": "/Teachers", "realmRoles": ["edulims-teacher"] },
    { "name": "Administrators", "path": "/Administrators", "realmRoles": ["edulims-admin"] }
  ],
  "clients": [
    {
      "clientId": "edulims",
      "name": "eduLIMS",
      "description": "The eduLIMS server (better-auth), development only",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "edulims-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["http://localhost:3000/api/auth/callback/keycloak"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "defaultClientScopes": ["openid", "profile", "email", "roles", "web-origins", "basic"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "realm roles in the ID token (realm_access.roles)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "group paths in the ID token (groups)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "edulims-test",
      "name": "eduLIMS role-mapping test",
      "description": "Development realm only: the integration test reads ID-token claims with the password grant. Never the app client.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "edulims-test-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": ["openid", "profile", "email", "roles", "basic"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "realm roles in the ID token (realm_access.roles)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "group paths in the ID token (groups)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "student",
      "email": "student@edulims.test",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Student",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "student", "temporary": false }],
      "groups": ["/Students"]
    },
    {
      "username": "teacher",
      "email": "teacher@edulims.test",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Teacher",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "teacher", "temporary": false }],
      "groups": ["/Teachers"]
    },
    {
      "username": "admin",
      "email": "admin@edulims.test",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Administrator",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["edulims-admin"]
    },
    {
      "username": "coordinator",
      "email": "coordinator@edulims.test",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Coordinator",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "coordinator", "temporary": false }],
      "groups": ["/Teachers", "/Administrators"]
    },
    {
      "username": "teacher-direct",
      "email": "teacher-direct@edulims.test",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Direct Teacher",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "teacher-direct", "temporary": false }],
      "realmRoles": ["edulims-teacher"]
    },
    {
      "username": "mixed",
      "email": "mixed@edulims.test",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Mixed Coordinator",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "mixed", "temporary": false }],
      "realmRoles": ["edulims-admin"],
      "groups": ["/Teachers"]
    },
    {
      "username": "conflict",
      "email": "conflict@edulims.test",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Conflict",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "conflict", "temporary": false }],
      "groups": ["/Students", "/Teachers"]
    },
    {
      "username": "norole",
      "email": "norole@edulims.test",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "No Role",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "norole", "temporary": false }]
    }
  ]
}

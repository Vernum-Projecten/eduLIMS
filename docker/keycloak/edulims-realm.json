{
  "realm": "edulims",
  "displayName": "eduLIMS (development)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "edulims-student",
        "description": "Student: registers samples, uploads results, reads only their own data"
      },
      {
        "name": "edulims-teacher",
        "description": "Teacher: manages and assesses the practicals they own"
      },
      {
        "name": "edulims-admin",
        "description": "Administrator: assigns roles and watches the integrations"
      }
    ]
  },
  "groups": [
    {
      "name": "Students",
      "path": "/Students",
      "realmRoles": ["edulims-student"]
    },
    {
      "name": "Teachers",
      "path": "/Teachers",
      "realmRoles": ["edulims-teacher"]
    },
    {
      "name": "Administrators",
      "path": "/Administrators",
      "realmRoles": ["edulims-admin"]
    }
  ],
  "clients": [
    {
      "clientId": "edulims",
      "name": "eduLIMS",
      "description": "The eduLIMS server's OIDC provider `keycloak` (pnpm db:seed), development only; any localhost port, because each e2e run picks a free one",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "edulims-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["http://localhost:*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:3100"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["openid", "profile", "email", "roles", "web-origins", "basic"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "realm roles in the ID token (realm_access.roles)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "group paths in the ID token (groups)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "edulims-test",
      "name": "eduLIMS role-mapping test",
      "description": "Development realm only: the integration test reads ID-token claims with the password grant. Never the app client.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "edulims-test-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": ["openid", "profile", "email", "roles", "basic"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "realm roles in the ID token (realm_access.roles)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "group paths in the ID token (groups)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "http://localhost:3000/api/auth/sso/saml2/sp/metadata?providerId=keycloak-saml",
      "name": "eduLIMS (SAML)",
      "description": "The eduLIMS server's SAML provider `keycloak-saml` (pnpm db:seed), development only",
      "enabled": true,
      "protocol": "saml",
      "publicClient": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:3000/api/auth/sso/saml2/sp/acs/keycloak-saml",
        "http://localhost:3000/api/auth/sso/saml2/sp/slo/keycloak-saml"
      ],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.authnstatement": "true",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "persistent",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#",
        "saml_assertion_consumer_url_post": "http://localhost:3000/api/auth/sso/saml2/sp/acs/keycloak-saml",
        "saml_single_logout_service_url_redirect": "http://localhost:3000/api/auth/sso/saml2/sp/slo/keycloak-saml",
        "saml_single_logout_service_url_post": "http://localhost:3000/api/auth/sso/saml2/sp/slo/keycloak-saml"
      },
      "defaultClientScopes": ["role_list"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "realm roles (Role, multivalued)",
          "protocol": "saml",
          "protocolMapper": "saml-role-list-mapper",
          "consentRequired": false,
          "config": {
            "single": "true",
            "attribute.nameformat": "Basic",
            "attribute.name": "Role"
          }
        },
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "attribute.nameformat": "Basic",
            "attribute.name": "email"
          }
        },
        {
          "name": "givenName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "attribute.nameformat": "Basic",
            "attribute.name": "givenName"
          }
        },
        {
          "name": "surname",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "attribute.nameformat": "Basic",
            "attribute.name": "surname"
          }
        }
      ]
    }
  ],
  "users": [
    {
